# Copy to .env (untracked) and load with: set -a && source .env && set +a
# Login through Pocket ID; the client's callback is <base url>/auth/callback.
FINANZFUCHS_BASE_URL=http://localhost:8000
OIDC_ISSUER=https://id.fuxbau.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Signs the session cookie; create one with: openssl rand -base64 48
SESSION_SECRET=

# Optional, with defaults:
# OIDC_ALLOWED_GROUP=fuxbau
# FINANZFUCHS_DATABASE=data/finanzfuchs.db
