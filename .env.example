# Copy to .env (untracked) and load with: set -a && source .env && set +a

# Google Sheet (see docs/setup-google-sheet.md)
GOOGLE_SERVICE_ACCOUNT_FILE=
# The long id between /d/ and /edit in the sheet's address.
BAUPLAN_SPREADSHEET_ID=

# Enable Banking (see docs/setup-enable-banking.md); not needed for CSV imports.

# Application ID from the Enable Banking control panel (also the name of the downloaded .pem file).
ENABLE_BANKING_APPLICATION_ID=
# Path to the private key Enable Banking generated when the application was registered.
ENABLE_BANKING_PRIVATE_KEY_PATH=
# One of the redirect URLs registered for the application. It does not need to serve anything:
# after the bank approval you copy the address from the browser into the terminal.
ENABLE_BANKING_REDIRECT_URL=https://fuxbau.org/bauplan/callback

# Optional, with defaults:
# ENABLE_BANKING_BANK_NAME=DKB
# BAUPLAN_DATA_DIR=data
# BAUPLAN_HISTORY_START=2026-01-01
