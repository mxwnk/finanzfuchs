# Copy to .env (untracked) and load with: set -a && source .env && set +a

# Web app and login (Pocket ID client with callback <base url>/auth/callback)
FINANZFUCHS_BASE_URL=http://localhost:8000
OIDC_ISSUER=https://id.fuxbau.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional, with defaults:
# OIDC_ALLOWED_GROUP=fuxbau
# FINANZFUCHS_HOST=127.0.0.1
# FINANZFUCHS_PORT=8000
# FINANZFUCHS_DATA_DIR=data
# FINANZFUCHS_HISTORY_START=2026-01-01

# Enable Banking (see docs/setup-enable-banking.md); not needed for CSV imports.
# ENABLE_BANKING_APPLICATION_ID=
# ENABLE_BANKING_PRIVATE_KEY_PATH=
# ENABLE_BANKING_REDIRECT_URL=
# ENABLE_BANKING_BANK_NAME=DKB
